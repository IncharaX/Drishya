PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/drishya
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this to the exact tag shown by `ollama list` when connecting inference.
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000
INFERENCE_URL=http://127.0.0.1:8001
INFERENCE_SECRET=use-the-same-random-secret-as-the-python-service
MEDIA_ROOT=../../data

# Local video tools. Chrome uses an isolated headless profile. No browser download is required.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional override; otherwise the installed Google Chrome channel is used.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Set only through the dedicated local profile; standard continues to use Neon.
APP_PROFILE=standard
