{
  "name": "@drishya/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx --env-file=.env src/check-db.ts",
    "test:auth": "tsx --env-file=.env scripts/smoke-auth.ts"
  },
  "dependencies": {
    "@drishya/contracts": "workspace:*",
    "@drishya/db": "workspace:*",
    "better-auth": "1.7.13",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7",
    "drizzle-orm": "0.45.4",
    "@drishya/ai": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
