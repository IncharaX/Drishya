{
  "name": "@drishya/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx --env-file=.env src/check-db.ts",
    "test:auth": "tsx --env-file=.env scripts/smoke-auth.ts",
    "test:speech": "tsx --env-file=.env scripts/smoke-speech.ts",
    "test:jobs": "tsx --env-file=../../.env.offline scripts/smoke-jobs.ts",
    "test:explanation:rules": "tsx --env-file=.env scripts/check-explanation-rules.ts",
    "test:explanation:state": "tsx --env-file=../../.env.offline scripts/check-explanation-state.ts",
    "test:explanation": "tsx --env-file=.env scripts/smoke-explanation.ts"
  },
  "dependencies": {
    "@drishya/ai": "workspace:*",
    "@drishya/contracts": "workspace:*",
    "@drishya/db": "workspace:*",
    "@drishya/motion": "workspace:*",
    "@drishya/renderer": "workspace:*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-kannada": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
