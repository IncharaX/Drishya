{
  "name": "drishya",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "pnpm --filter @drishya/db db:generate",
    "db:migrate": "pnpm --filter @drishya/db db:migrate",
    "db:studio": "pnpm --filter @drishya/db db:studio",
    "db:check": "pnpm --filter @drishya/api db:check",
    "ui:add": "pnpm --filter @drishya/web exec shadcn add",
    "test:auth": "pnpm --filter @drishya/api test:auth"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
